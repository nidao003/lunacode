# LunaCode Connect (self-hosted auth + relay + built-in t3_relay tunnel gateway)
# Leave LUNACODE_CONNECT_URL unset to let each Desktop / Web / Mobile client configure its
# backend server URL at runtime in the login modal or Settings (self-hosted auth remains enabled).
# Set LUNACODE_CONNECT_URL=off to disable cloud features completely.
# LUNACODE_CONNECT_URL=https://connect.example.com:8443

# Or override auth, relay, and hosted app origins independently:
# LUNACODE_AUTH_URL=https://connect.example.com:8443
# T3CODE_RELAY_URL=https://connect.example.com:8443
# T3CODE_HOSTED_APP_URL=https://connect.example.com:8443

# Optional legacy Clerk configuration (only when switching back to Clerk auth):
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_...
# T3CODE_CLERK_JWT_TEMPLATE=t3-relay
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=...
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Public, ingest-only mobile OpenTelemetry configuration (disabled by default in LunaCode).
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
