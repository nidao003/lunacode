# Bind host on Docker host (0.0.0.0 accepts LAN/local reverse proxies; set 127.0.0.1 for loopback-only proxy)
LUNACODE_BIND_HOST=0.0.0.0
LUNACODE_HOST_PORT=8787
# Optional image override (defaults to Docker Hub multi-arch image nidao008/lunacode-connect:latest)
# LUNACODE_CONNECT_IMAGE=nidao008/lunacode-connect:latest

# Public HTTPS origin for auth, OAuth2, JWKS, Relay control plane, and Hosted Web App
PUBLIC_ORIGIN=https://connect.example.com:8443
TUNNEL_BASE_SCHEME=https
TUNNEL_PUBLIC_PORT=8443

# Optional wildcard subdomain mode (e.g. `env-<16hex>.example.com:8443`) unlocks Guest Links, MCP OAuth, and PeerLinks.
# Requires Nginx/Caddy/reverse proxy for `*.example.com:8443` + `connect.example.com:8443` -> `127.0.0.1:8787`.
# Leave empty to use single-domain path-prefix routing (https://connect.example.com:8443/t/<slug>/).
# TUNNEL_WILDCARD_DOMAIN=example.com
TUNNEL_WILDCARD_DOMAIN=
# TUNNEL_SINGLE_DOMAIN=

# Default per-user managed tunnel limit (can be overridden per user in /admin console)
DEFAULT_USER_MAX_TUNNELS=3

# Optional push credentials (APNs HTTP/2 for iOS & Live Activities, FCM HTTP v1 for Android)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.nidao003.lunacode.mobile
# APNS_PRIVATE_KEY_P8=
# APNS_PRIVATE_KEY_PATH=/data/apns.p8
# APNS_USE_SANDBOX=false
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_PATH=/data/firebase-sa.json

# Registration policy: can also be toggled live from /admin super-admin console
ALLOW_REGISTRATION=true

# Optional comma-separated email whitelist for self-registration
# ALLOWED_EMAILS=you@example.com

# Super admins: comma-separated emails automatically promoted to `admin`.
# Note: upgrading an existing DB automatically promotes the earliest registered user if no admin exists yet.
# ADMIN_EMAILS=you@example.com
# Optional bootstrap super-admin created on first startup when missing:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-password

# Optional comma-separated extra CORS origins (empty allows client origins)
# CORS_ALLOWED_ORIGINS=

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
SESSION_TTL_SEC=2592000
DPOP_TOKEN_TTL_SEC=1800
